[ model = 'Two-flavor QCD' ]

% Propagators:

[Qi, Qibar, -; color='gold', style='solid']
[Qj, Qjbar, -; color='firebrick', style='solid']
[Gh, Ghbar, -; color='dimgray', style='bold']
[Gl, Gl, +; color='crimson', style='dashed']
% external photon for e^+ e^- to partons
[Ga, Ga, +, external; color='orange', style='dashed']

% Vertices:

[Qibar, Qi, Gl; gs='1', el='0']
[Qjbar, Qj, Gl; gs='1', el='0']
[Gl, Gl, Gl, Gl; gs='2', el='0']
[Gl, Gl, Gl; gs='1', el='0']
[Ghbar, Gh, Gl; gs='1', el='0']
[Qibar, Qi, Ga; gs='0', el='1']
[Qjbar, Qj, Ga; gs='0', el='1']
