
//===//
graph "1" {
  graph [overlap=false,fontsize=3,penwidth=0.5];
  node [shape=point];
  label="diagram 1 (factor = -1)";
  in1--1 [label="I:  Gl (p1)", fontsize=3, style=dashed,
color=crimson];
  2--out1 [label="O:  Gl (q1)", fontsize=3, style=dashed,
color=crimson];
  1--2 [label="Qi (k1-p1)", fontsize=3,  style=solid,
color=gold];
  2--1 [label="Qi (k1)", fontsize=3,  style=solid,
color=gold];
}

